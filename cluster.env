# ---------------------------------------------------------------------------
# Cluster / deployment configuration
# Sourced by every script under scripts/. Edit here, not in the scripts.
# ---------------------------------------------------------------------------

# --- Cluster topology ---
CP_IP="192.168.56.134"          # control-plane node (kube-apiserver)
CP_NAME="k8s-cp-0"
WORKER_IP="192.168.56.135"
WORKER_NAME="k8s-w-0"
SSH_USER="root"

# --- Kubeflow distribution ---
KF_VERSION="26.03.1"            # kubeflow/community-distribution release tag
KF_REPO="https://github.com/kubeflow/community-distribution.git"

# --- Pinned component versions (must stay in sync with KF_VERSION) ---
LOCAL_PATH_VERSION="v0.0.37"
CERT_MANAGER_VERSION="v1.20.2"
ISTIO_VERSION="1.30.1"
KSERVE_VERSION="v0.18.0"
TRAINER_VERSION="2.2.0"
SPARK_OPERATOR_VERSION="2.5.0"

# --- Local tooling versions ---
KUBECTL_VERSION="v1.36.3"
HELM_VERSION="v3.21.3"       # latest Helm 3. Helm 4 is out but these charts target v3.
KUSTOMIZE_VERSION="v5.8.1"

# --- Access ---
KF_HTTP_NODEPORT="31380"        # istio-ingressgateway http2 NodePort
KF_HTTPS_NODEPORT="31390"

# --- Dex static login ---
KF_USER_EMAIL="user@example.com"
KF_USER_PASSWORD="12341234"
KF_PROFILE_NAME="kubeflow-user-example-com"

# --- Feature flags -----------------------------------------------------------
# "helm"      -> install via Helm chart
# "kustomize" -> install via Kubeflow's version-matched kustomize overlay
# "off"       -> skip entirely
#
# Fallback: if a Helm-installed component misbehaves or does not surface in the
# Central Dashboard, flip it to "kustomize" and re-run `make apps`.
INSTALL_KSERVE="helm"
INSTALL_TRAINER="helm"
INSTALL_SPARK="helm"
INSTALL_KATIB="kustomize"       # experimental Helm chart is v0.16.0 vs required v0.19.0
INSTALL_NOTEBOOKS="kustomize"
INSTALL_PIPELINES="kustomize"

# Trimmed to fit the RAM budget. Set to "kustomize" to re-enable.
INSTALL_HUB="off"               # Kubeflow Hub: 2112Mi RAM + 20GB PVC
INSTALL_KNATIVE="off"           # only needed for KServe Serverless (scale-to-zero)
INSTALL_TRAINING_OPERATOR="off" # legacy v1.9.2, superseded by Trainer v2.2.0

# --- Paths ---
CACHE_DIR="${CACHE_DIR:-/root/kube-flow/.cache}"
MANIFESTS_DIR="${CACHE_DIR}/community-distribution"
